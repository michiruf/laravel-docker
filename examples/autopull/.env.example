# Repository to deploy (https or ssh)
# Private repositories over https: put the token into the URL, e.g.
#   GIT_URL=https://x-access-token:<token>@github.com/you/app.git
GIT_URL=
# Branch to deploy; empty uses the remote default branch
BRANCH=

# Private repositories over ssh: the private deploy key. Use the base64 form
# (base64 -w0 < key) — .env values cannot span multiple lines.
GIT_SSH_KEY=
# Optional known_hosts line(s) to pin the host key; empty trusts on first use
GIT_SSH_KNOWN_HOSTS=

# Host port the application is exposed on
HOST_PORT=8080

# Database credentials (used by mysql and injected into the application)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=laravel
MYSQL_USER=laravel
MYSQL_PASSWORD=
